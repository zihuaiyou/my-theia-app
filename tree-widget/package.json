{
  "name": "tree-widget",
  "keywords": [
    "theia-extension"
  ],
  "version": "0.0.0",
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/core": "1.71.1"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "prepare": "npm run clean && npm run build",
    "clean": "rimraf lib",
    "build": "tsc && npm run copy:styles",
    "watch": "tsc -w",
    "copy:styles": "xcopy \"src\\browser\\styles\" \"lib\\browser\\styles\" /s /i /y"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/tree-widget-frontend-module"
    }
  ]
}